# Release identity
RELEASE_TAG=v-test
APP_IMAGE_REF=electricity-monitor:v-test
REDIS_IMAGE_REF=redis:8-alpine

# Stable container identity used by deploy/rollback
APP_CONTAINER_NAME=electricity-app
REDIS_CONTAINER_NAME=electricity-redis
COMPOSE_PROJECT_NAME=electricity-monitor
DOCKER_RESTART_POLICY=unless-stopped

# Published port
APP_BIND_ADDRESS=127.0.0.1
APP_HOST_PORT=11450
APP_CONTAINER_PORT=8000

# Runtime defaults
APP_ENV=production
APP__REDIS__HOST=redis
APP__REDIS__PORT=6379
APP__LOGGING__LEVEL=info
REDIS_MAX_MEMORY=128mb

# Required secret
APP__JWT__SECRET=CHANGE-ME

# Health check used by deploy.sh
DEPLOY_HEALTHCHECK_URL=http://127.0.0.1:11450/api/health
DEPLOY_HEALTHCHECK_RETRIES=20
DEPLOY_HEALTHCHECK_INTERVAL=3

# Optional database overrides
# APP__DATABASE__HOST=47.92.117.121
# APP__DATABASE__PORT=5432
# APP__DATABASE__USERNAME=postgres
# APP__DATABASE__PASSWORD=postgres
# APP__DATABASE__DATABASE=electricity_pro
