# 生产环境运行时模板
# 使用方式：复制为 config/production.toml 后按目标环境修改

[server]
host = "0.0.0.0"
port = 8000

[database]
type = "postgres"
host = "db.example.internal"
port = 5432
username = "postgres"
password = ""
password_file = "/run/secrets/app_database_password"
database = "electricity_pro"
max_connections = 20
min_connections = 5
connection_timeout = 30

[jwt]
secret = ""
secret_file = "/run/secrets/app_jwt_secret"
expiration_hours = 24

[logging]
level = "info"
format = "json"

[redis]
host = "127.0.0.1"
port = 6379
max_connections = 10
min_connections = 2
connection_timeout = 30

[rate_limit]
insert_per_second = 200
query_per_second = 200

[room_sync]
enabled = true
interval_hours = 24
default_threshold = 100.0

[room_sync.crawler]
api_url = "https://zywxhd02.gxust.edu.cn/Home/GetRoomTree"
timeout_seconds = 30
connect_timeout_seconds = 10
max_retries = 3
concurrency = 50

[electricity_fetcher]
enabled = true
api_url = "https://zywxhd02.gxust.edu.cn/Home/GetRoomInfo?roomid="
fetch_interval_minutes = 5
history_interval_hours = 1
history_retention_days = 8
max_retries = 2
retry_delay_seconds = 30
retry_backoff_multiplier = 2.0

[qq_bot]
api_url = "http://127.0.0.1:3000/send_private_msg"
bearer_token = ""
bearer_token_file = "/run/secrets/app_qq_bot_bearer_token"
timeout_seconds = 10

[verification]
code_length = 6
expire_seconds = 300
redis_key_prefix = "verify"

[notification]
concurrent_send_limit = 10
query_interval_secs = 60
debounce_period_secs = 3600
recovery_monitor_interval_secs = 300

[admin]
default_qq_number = "100000001"

[static_files]
enabled = true
directory = "static"
index_file = "index.html"
cache_max_age_seconds = 31536000
html_cache_seconds = 0
