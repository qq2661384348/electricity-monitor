# 开发环境运行时模板
# 使用方式：复制为 config/development.toml 后按本地环境修改

[server]
host = "127.0.0.1"
port = 8000

[public_site]
# 通知消息中的公开访问链接由这里生成；模板故意留空，复制为运行时配置后必须填写。
domain = ""
port = ""

[database]
# 开发环境只允许连接本地 PostgreSQL。
# 复制为 config/development.toml 后，必须把 password 改成当前本地 PostgreSQL 的真实密码。
type = "postgres"
host = "127.0.0.1"
port = 5432
username = "postgres"
password = "CHANGE-THIS-LOCAL-POSTGRES-PASSWORD"
database = "electricity_dev"
max_connections = 5
min_connections = 1
connection_timeout = 30

[jwt]
secret = "local-dev-jwt-secret"
expiration_hours = 24

[auth]
refresh_expiration_hours = 168
refresh_cookie_secure = false
refresh_cookie_same_site = "lax"

[logging]
level = "info"
format = "pretty"

[redis]
host = "127.0.0.1"
port = 6379
max_connections = 10
min_connections = 2
connection_timeout = 30

[cors]
allowed_origins = "http://localhost:5173"

[rate_limit]
insert_per_second = 200
query_per_second = 200

[room_sync]
enabled = true
interval_hours = 24
default_threshold = 100.0

[room_sync.crawler]
api_url = "https://zywxhd02.gxust.edu.cn/Home/GetRoomTree"
timeout_seconds = 30
connect_timeout_seconds = 10
max_retries = 3
concurrency = 50

[electricity_fetcher]
enabled = true
api_url = "https://zywxhd02.gxust.edu.cn/Home/GetRoomInfo?roomid="
fetch_interval_minutes = 5
history_interval_hours = 1
history_retention_days = 8
max_retries = 2
retry_delay_seconds = 30
retry_backoff_multiplier = 2.0

[qq_bot]
# QQ 私聊发送链路：登录验证码和电量通知都会通过此 NapCat action 发送。
# NapCat HTTP action 地址，例如：http://127.0.0.1:3000/send_private_msg
api_url = "你的napcat应用URL"
# 必须填写已经部署并登录的机器人 QQ 号；前端会公开展示该值用于用户添加好友。
public_qq_number = ""
# 公开仓库不保存真实 token；本地调试请通过 APP__QQ_BOT__BEARER_TOKEN(_FILE) 注入
bearer_token = ""
timeout_seconds = 10

[email]
# SMTP 邮件发送链路；填写完整 host、user 和授权码后会启用邮箱登录与邮箱电量通知。
smtp_host = "smtp.qq.com"
smtp_port = 465
smtp_user = "cogniaegis@qq.com"
# 公开仓库不保存真实 SMTP 授权码；本地调试请通过 APP__EMAIL__SMTP_PASSWORD(_FILE) 注入。
smtp_password = ""
smtp_use_tls = true
from_name = "CogniAegis"
timeout_seconds = 30
max_retries = 3
retry_delay_seconds = 2

[captcha]
api_url = "https://v2.xxapi.cn/api/captcha"
request_timeout_seconds = 5
token_expire_seconds = 60
captcha_type = "math"
width = 300
height = 100
options = 2

[verification]
code_length = 6
expire_seconds = 300
redis_key_prefix = "verify"

[notification]
concurrent_send_limit = 10
query_interval_secs = 60
debounce_period_secs = 3600
recovery_monitor_interval_secs = 300

[admin]
default_qq_number = "100000001"

[static_files]
enabled = true
directory = "static"
index_file = "index.html"
cache_max_age_seconds = 31536000
html_cache_seconds = 0
